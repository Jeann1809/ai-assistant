# Copy to .env and fill in real values. Never commit .env.

# --- Gemini API ---
# Key must live on a Google Cloud project with NO billing enabled (see CLAUDE.md).
GEMINI_API_KEY=your_gemini_api_key_here
# Current Flash model id — check ai.google.dev for the latest alias before relying on this.
GEMINI_MODEL=gemini-flash-latest

# --- Gmail (OAuth 2.0 + PKCE, installed-app type, no client secret) ---
GMAIL_CLIENT_ID=your_gmail_oauth_client_id_here
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback

# --- Microsoft Graph (OAuth 2.0 + PKCE, public client, no client secret) ---
MS_GRAPH_CLIENT_ID=your_ms_graph_client_id_here
# "consumers" restricts to personal Microsoft accounts only; use "common" to also allow work/school accounts.
MS_GRAPH_TENANT_ID=consumers
MS_GRAPH_REDIRECT_URI=http://localhost:3000/graph/oauth2callback

# --- WhatsApp (Baileys) ---
WHATSAPP_AUTH_DIR=./auth_info_baileys

# --- Memory (SQLite) ---
SHORT_TERM_DB_PATH=./data/short-term.sqlite
LONG_TERM_DB_PATH=./data/long-term.sqlite

# --- Logging ---
LOG_LEVEL=info
