# Copy to .env and fill in real values. Never commit .env.

# --- Gemini API ---
# Key must live on a Google Cloud project with NO billing enabled (see CLAUDE.md).
GEMINI_API_KEY=your_gemini_api_key_here
# Pinned to a stable (non-bleeding-edge) Flash version rather than the "latest"
# alias — newer model versions saw frequent 503 UNAVAILABLE ("high demand")
# errors in testing. Recheck ai.google.dev periodically for a better pin.
GEMINI_MODEL=gemini-2.5-flash

# --- Web search (Tavily) ---
# Free tier — sign up at tavily.com. Used as a Gemini function-calling tool
# since Google Search grounding requires billing on the Gemini API free tier.
TAVILY_API_KEY=your_tavily_api_key_here

# --- Gmail (OAuth 2.0 + PKCE, Desktop app) ---
GMAIL_CLIENT_ID=your_gmail_oauth_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret_here
# Run npm.cmd run gmail:auth. Uses a random loopback port and data/token-gmail.json.
# To enable confirmed sending: npm.cmd run gmail:auth -- --send (readonly + send).
# Testing mode: expect to authorize again after 7 days.

# --- Microsoft Graph (OAuth 2.0 + PKCE, public client, no client secret) ---
MS_GRAPH_CLIENT_ID=your_ms_graph_client_id_here
# "consumers" restricts to personal Microsoft accounts only; use "common" to also allow work/school accounts.
MS_GRAPH_TENANT_ID=consumers
MS_GRAPH_REDIRECT_URI=http://localhost:3000/graph/oauth2callback

# --- WhatsApp (Baileys) ---
WHATSAPP_AUTH_DIR=./auth_info_baileys
# Your OTHER number that sends messages to the linked bot, country code + digits.
# Required; all other senders are ignored. No spaces or punctuation except +.
WHATSAPP_OWNER_NUMBER=

# --- Memory (SQLite) ---
SHORT_TERM_DB_PATH=./data/short-term.sqlite
LONG_TERM_DB_PATH=./data/long-term.sqlite

# --- Logging ---
LOG_LEVEL=info
